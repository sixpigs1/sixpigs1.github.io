---
import BaseLayout from "@/layouts/BaseLayout.astro";
import JourneyCard from "@/components/JourneyCard.astro";
import ReflectionCard from "@/components/ReflectionCard.astro";
import {
    getSortedJourneyExperiences,
    getSortedReflections,
} from "@/data/journey";
import { ui } from "@/data/i18n";

const journeyExperiences = getSortedJourneyExperiences();
const reflections = getSortedReflections();
---

<BaseLayout title="Journey - Zewei Ye">
    <h1 class="page-title">{ui.journey.title}</h1>

    <!-- Experiences beyond Research Section -->
    <section class="section">
        <h2 class="section-title">{ui.journey.beyondResearch}</h2>
        {
            journeyExperiences.map((exp) => (
                <JourneyCard
                    year={exp.year}
                    name={exp.name}
                    description={exp.description}
                    images={exp.images}
                    expandedContent={exp.expandedContent}
                />
            ))
        }
    </section>

    <!-- Reflections Section -->
    {
        reflections.length > 0 && (
            <section class="section">
                <h2 class="section-title">{ui.journey.reflections}</h2>
                {reflections.map((r) => (
                    <ReflectionCard
                        title={r.title}
                        date={r.date}
                        content={r.content}
                    />
                ))}
            </section>
        )
    }
</BaseLayout>

<style>
    .page-title {
        font-size: 2.5rem;
        margin-bottom: var(--spacing-xl);
        padding-bottom: var(--spacing-md);
        border-bottom: 2px solid var(--color-border);
    }
</style>
