---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/Card.astro';
import { getAwardsByCategory } from '@/data/awards';
import { ui } from '@/data/i18n';

const academicAwards = getAwardsByCategory('academic');
const competitionAwards = getAwardsByCategory('competition');
---

<BaseLayout title="Awards - Zewei Ye">
  <h1 class="page-title">{ui.awards.title}</h1>

  <!-- Academic Awards Section -->
  {academicAwards.length > 0 && (
    <section class="section">
      <h2 class="section-title">{ui.awards.academic}</h2>
      {academicAwards.map(award => (
        <Card
          title={`[${award.year}] ${award.name.en}${award.name.zh ? ` (${award.name.zh})` : ''}`}
          meta={award.organization.en}
          description={award.description?.en}
          image={award.image}
        />
      ))}
    </section>
  )}

  <!-- Competitions / Grants Section -->
  {competitionAwards.length > 0 && (
    <section class="section">
      <h2 class="section-title">{ui.awards.competitions}</h2>
      {competitionAwards.map(award => (
        <Card
          title={`[${award.year}] ${award.name.en}${award.name.zh ? ` (${award.name.zh})` : ''}`}
          meta={award.organization.en}
          description={award.description?.en}
          image={award.image}
        />
      ))}
    </section>
  )}
</BaseLayout>

<style>
  .page-title {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-xl);
    padding-bottom: var(--spacing-md);
    border-bottom: 2px solid var(--color-border);
  }
</style>
