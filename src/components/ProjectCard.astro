---
interface Props {
    date: string;
    title: string;
    description: string;
    image?: string;
}

const { date, title, description, image } = Astro.props;

// Render description:
//   [text](url)          → <a href="url">text</a>
//   bare https://...     → <a href="url">url</a>  (only when NOT already inside [](url))
//   \n                   → <br/>
function renderDescription(text: string): string {
    // Step 1: replace [text](url) with a placeholder to protect from step 2
    const links: string[] = [];
    const withPlaceholders = text.replace(
        /\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g,
        (_match, label, url) => {
            const idx = links.length;
            links.push(
                `<a href="${url}" target="_blank" rel="noopener noreferrer">${label}</a>`,
            );
            return `\x00LINK${idx}\x00`;
        },
    );
    // Step 2: replace remaining bare URLs
    const withBareLinks = withPlaceholders.replace(
        /(https?:\/\/[^\s<>"）\x00]+)/g,
        '<a href="$1" target="_blank" rel="noopener noreferrer">$1</a>',
    );
    // Step 3: restore placeholders
    const restored = withBareLinks.replace(
        /\x00LINK(\d+)\x00/g,
        (_, i) => links[Number(i)],
    );
    // Step 4: newlines → <br/>
    return restored.replace(/\n/g, "<br/>");
}
---

<div class="project-card">
    {
        image && (
            <div class="project-image">
                <img src={image} alt={title} loading="lazy" />
            </div>
        )
    }
    <div class="project-content">
        <h3 class="project-title">
            <span class="project-date">[{date}]</span>
            {title}
        </h3>
        <p
            class="project-description"
            set:html={renderDescription(description)}
        />
    </div>
</div>

<style>
    .project-card {
        display: flex;
        gap: var(--spacing-lg);
        padding: var(--spacing-lg);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        margin-bottom: var(--spacing-md);
        background: white;
        align-items: flex-start;
    }

    .project-image {
        flex-shrink: 0;
        width: 320px;
        height: 400px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: #f5f5f5;
        border-radius: 6px;
    }

    .project-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .project-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
    }

    .project-title {
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--color-text);
        margin: 0;
        line-height: 1.4;
    }

    .project-date {
        color: var(--color-accent);
        font-weight: 600;
        margin-right: 0.4em;
    }

    .project-description {
        color: var(--color-text-light);
        line-height: 1.7;
        margin: 0;
        font-size: 0.95rem;
    }

    @media (max-width: 768px) {
        .project-card {
            flex-direction: column;
        }
        .project-image {
            width: 100%;
            height: 200px;
        }
    }
</style>
