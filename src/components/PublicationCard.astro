---
interface Props {
    title: string;
    authors?: string;
    status?: string;
    abstract?: string;
    image?: string;
    links?: Array<{ text: string; url: string } | false>;
}

const { title, authors, status, abstract, image, links = [] } = Astro.props;
const validLinks = links.filter(Boolean) as Array<{
    text: string;
    url: string;
}>;
---

<div class="pub-card">
    {
        image && (
            <div class="pub-image">
                <img src={image} alt={title} loading="lazy" />
            </div>
        )
    }
    <div class="pub-content">
        <h3 class="pub-title">{title}</h3>
        {
            authors && (
                <p
                    class="pub-authors"
                    set:html={authors.replace(/Zewei Ye/g, "<u>Zewei Ye</u>")}
                />
            )
        }
        {status && <p class="pub-status">{status}</p>}
        {
            abstract && (
                <p class="pub-abstract">
                    <strong>Abstract.</strong> {abstract}
                </p>
            )
        }
        {
            validLinks.length > 0 && (
                <div class="pub-links">
                    {validLinks.map((link) => (
                        <a
                            href={link.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="pub-link"
                        >
                            {link.text}
                        </a>
                    ))}
                </div>
            )
        }
    </div>
</div>

<style>
    .pub-card {
        display: flex;
        gap: var(--spacing-lg);
        padding: var(--spacing-lg);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        margin-bottom: var(--spacing-md);
        background: white;
    }

    .pub-image {
        width: 360px;
        min-width: 360px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: #f5f5f5;
        border-radius: 4px;
    }

    .pub-image img {
        width: 100%;
        height: auto;
        object-fit: contain;
        display: block;
    }

    .pub-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
    }

    .pub-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--color-text);
        margin: 0;
    }

    .pub-authors {
        font-size: 0.95rem;
        color: var(--color-text-light);
        margin: 0;
    }

    .pub-status {
        font-size: 0.85rem;
        color: var(--color-accent);
        font-style: italic;
        margin: 0;
    }

    .pub-abstract {
        font-size: 0.8rem;
        color: var(--color-text-light);
        line-height: 1.6;
        margin: 0;
    }

    .pub-links {
        display: flex;
        gap: var(--spacing-sm);
        flex-wrap: wrap;
        margin-top: var(--spacing-xs);
    }

    .pub-link {
        font-size: 0.85rem;
        padding: 2px 10px;
        border: 1px solid var(--color-accent);
        border-radius: 4px;
        color: var(--color-accent);
        text-decoration: none;
        transition:
            background 0.15s,
            color 0.15s;
    }

    .pub-link:hover {
        background: var(--color-accent);
        color: white;
        text-decoration: none;
    }

    @media (max-width: 640px) {
        .pub-card {
            flex-direction: column;
        }
        .pub-image {
            width: 100%;
            min-width: unset;
        }
    }
</style>
